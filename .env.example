# Local backend / long-running server. Percent-encode special characters in the password.
# For Vercel, copy the Transaction pooler URL from Supabase > Connect (port 6543).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ndhvuxynwrpspboppvyr.supabase.co:5432/postgres?sslmode=require

# Admin user seeded into Supabase on first run.
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Generate a random value of at least 32 characters.
EDITOR_SESSION_SECRET=replace-with-a-long-random-secret

# Production site origin, for example https://birthday.example.com
SITE_ORIGIN=http://localhost:5173
