# Local backend / long-running server. Percent-encode special characters in the password.
# For Vercel, copy the Transaction pooler URL from Supabase > Connect (port 6543).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ndhvuxynwrpspboppvyr.supabase.co:5432/postgres?sslmode=require

# Admin user seeded into Supabase on first run.
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Generate a random value of at least 32 characters.
EDITOR_SESSION_SECRET=replace-with-a-long-random-secret

# Production site origin, for example https://birthday.example.com
SITE_ORIGIN=http://localhost:5173

# New account platform: Cloudflare Turnstile (register action, hostname must match SITE_ORIGIN).
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Your trusted email adapter. Receives POST {to,purpose,url} with Bearer authorization.
# It must deliver verification/reset email and return a 2xx status only on acceptance.
AUTH_EMAIL_WEBHOOK=
AUTH_EMAIL_WEBHOOK_SECRET=

# false: register with CAPTCHA only; true: require verified email
EMAIL_VERIFICATION_REQUIRED=false
